generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECEPTIONIST
  NURSE
  DOCTOR
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Patient {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  phone     String?
  dob       DateTime
  notes     String?
  createdAt DateTime @default(now())

  appointments  Appointment[]
  invoices      Invoice[]
}

model Staff {
  id             String   @id @default(cuid())
  name           String
  role           Role
  email          String   @unique
  password       String
  specialisation String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  appointments      Appointment[]
  stockTransactions StockTransaction[]
}

model Appointment {
  id           String   @id @default(cuid())
  patientId    String
  staffId      String
  scheduledAt  DateTime
  durationMins Int      @default(30)
  status       Status   @default(PENDING)
  reason       String?
  outcome      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  invoice Invoice?
}

model Invoice {
  id            String        @id @default(cuid())
  patientId     String
  appointmentId String?       @unique
  amount        Float
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

enum StockType {
  RECEIVED
  USED
  ADJUSTED
  DISPOSED
}

model StockItem {
  id               String   @id @default(cuid())
  name             String
  category         String
  quantity         Int
  reorderThreshold Int
  unitCost         Decimal
  supplier         String?
  expiry           DateTime?
  createdAt        DateTime @default(now())

  transactions StockTransaction[]
}

model StockTransaction {
  id            String    @id @default(cuid())
  itemId        String
  staffId       String
  type          StockType
  quantityDelta Int
  occurredAt    DateTime  @default(now())
  notes         String?

  item  StockItem @relation(fields: [itemId], references: [id])
  staff Staff     @relation(fields: [staffId], references: [id])
}
