generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECEPTIONIST
  NURSE
  DOCTOR
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Patient {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  phone     String?
  dob       DateTime
  notes     String?
  createdAt DateTime @default(now())

  appointments  Appointment[]
  invoices      Invoice[]
  // Encounter back-relations (additive)
  encounters    Encounter[]
  prescriptions Prescription[]
  certificates  MedicalCertificate[]
  referrals     Referral[]
}

model Staff {
  id             String   @id @default(cuid())
  name           String
  role           Role
  email          String   @unique
  password       String
  specialisation String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  appointments        Appointment[]
  stockTransactions   StockTransaction[]
  // Encounter back-relations (additive)
  doctorEncounters    Encounter[]          @relation("DoctorEncounters")
  doctorPrescriptions Prescription[]       @relation("DoctorPrescriptions")
  doctorCertificates  MedicalCertificate[] @relation("DoctorCertificates")
  doctorReferrals     Referral[]           @relation("DoctorReferrals")
}

model Appointment {
  id           String   @id @default(cuid())
  patientId    String
  staffId      String
  scheduledAt  DateTime
  durationMins Int      @default(30)
  status       Status   @default(PENDING)
  reason       String?
  outcome      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])
  invoice   Invoice?
  // Encounter back-relation (additive)
  encounter Encounter?
}

model Invoice {
  id            String        @id @default(cuid())
  patientId     String
  appointmentId String?       @unique
  amount        Float
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

enum StockType {
  RECEIVED
  USED
  ADJUSTED
  DISPOSED
}

model StockItem {
  id               String    @id @default(cuid())
  name             String
  category         String
  quantity         Int
  reorderThreshold Int
  unitCost         Decimal
  supplier         String?
  expiry           DateTime?
  createdAt        DateTime  @default(now())

  transactions StockTransaction[]
}

model StockTransaction {
  id            String    @id @default(cuid())
  itemId        String
  staffId       String
  type          StockType
  quantityDelta Int
  occurredAt    DateTime  @default(now())
  notes         String?

  item  StockItem @relation(fields: [itemId], references: [id])
  staff Staff     @relation(fields: [staffId], references: [id])
}

// ─── Encounter Models ──────────────────────────────────────────────────────────

enum PrescriptionType {
  INTERNAL
  EXTERNAL
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
}

enum Urgency {
  ROUTINE
  URGENT
  EMERGENCY
}

model Encounter {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  patientId      String
  doctorId       String
  chiefComplaint String?
  examination    String?
  diagnosis      String?
  plan           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment  Appointment          @relation(fields: [appointmentId], references: [id])
  patient      Patient              @relation(fields: [patientId], references: [id])
  doctor       Staff                @relation("DoctorEncounters", fields: [doctorId], references: [id])
  prescriptions Prescription[]
  certificates  MedicalCertificate[]
  referrals     Referral[]
}

model Prescription {
  id          String             @id @default(cuid())
  encounterId String
  patientId   String
  doctorId    String
  type        PrescriptionType
  status      PrescriptionStatus @default(DRAFT)
  notes       String?
  issuedAt    DateTime?
  createdAt   DateTime           @default(now())

  encounter Encounter        @relation(fields: [encounterId], references: [id])
  patient   Patient          @relation(fields: [patientId], references: [id])
  doctor    Staff            @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  items     PrescriptionItem[]
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String
  durationDays   Int
  quantity       Int
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model MedicalCertificate {
  id          String    @id @default(cuid())
  encounterId String
  patientId   String
  doctorId    String
  diagnosis   String
  fitForWork  Boolean
  fromDate    DateTime
  toDate      DateTime
  notes       String?
  issuedAt    DateTime?
  createdAt   DateTime  @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  doctor    Staff     @relation("DoctorCertificates", fields: [doctorId], references: [id])
}

model Referral {
  id          String   @id @default(cuid())
  encounterId String
  patientId   String
  doctorId    String
  referredTo  String
  reason      String
  urgency     Urgency
  notes       String?
  issuedAt    DateTime?
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  doctor    Staff     @relation("DoctorReferrals", fields: [doctorId], references: [id])
}

// ─── Notifications ─────────────────────────────────────────────────────────────

enum NotificationUrgency {
  INFO
  WARNING
  URGENT
  CRITICAL
}

model Notification {
  id            String              @id @default(cuid())
  recipientId   String
  recipientType String              // 'PATIENT' | 'STAFF'
  title         String
  body          String
  urgency       NotificationUrgency @default(INFO)
  actionUrl     String?
  actionLabel   String?
  externalKey   String              @unique
  readAt        DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime            @default(now())

  @@index([recipientId, recipientType])
}
